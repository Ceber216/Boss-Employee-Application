<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="01" author="Piotr">
        <createTable tableName="simplifiedboss">
            <column name = "simplifiedboss_id" type="VARCHAR(36)">
                <constraints primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="02" author="Piotr">
        <createTable tableName="employees">
            <column name = "employees_id" type="VARCHAR(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="employees_name" type="VARCHAR(255)"/>
            <column name="employees_badge_number" type="INT"/>
            <column name="simplifiedboss_id" type="VARCHAR(36)"/>
        </createTable>
    </changeSet>


</databaseChangeLog>